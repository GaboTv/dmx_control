# auto tries uDMX first and falls back to mock if the adapter is unavailable.
# Use udmx in production when startup should fail unless hardware is present.
DMX_DRIVER=auto

# Local API server used by the web UI.
PORT=4174
HOST=127.0.0.1

# Anyma/uDMX default USB identifiers. Override only if your adapter differs.
UDMX_VENDOR_ID=0x16c0
UDMX_PRODUCT_ID=0x05dc

# uDMX channel offset is zero-based: Light A A001 starts at 0; Light B should be set to A009.
UDMX_START_ADDRESS=0

# Windows 11 + libusbK is usually more stable with single-channel writes and no idle refresh.
# UDMX_WRITE_MODE can be single, multi, or auto. auto tries multi then falls back to single.
UDMX_WRITE_MODE=single
UDMX_REFRESH_MS=0
DMX_WRITE_DEBOUNCE_MS=150
