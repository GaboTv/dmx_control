{
  "name": "dmx-light-control-app",
  "version": "0.2.3",
  "description": "Desktop DMX light control app for uDMX-compatible fixtures.",
  "author": "Retono",
  "private": true,
  "main": "dist/server/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n api,web,electron -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:electron:dev:app\"",
    "electron:dev:app": "wait-on http://127.0.0.1:5173/api/status && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --publish never",
    "electron:build:dir": "npm run build && npm run electron:compile && electron-builder --dir",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:soak": "tsx scripts/dmx-soak.ts",
    "test:soak:scene": "tsx scripts/dmx-soak.ts --interval-ms=50 --stats-interval-ms=5000 --operation-timeout-ms=5000 --blackout-interval-minutes=0 --reconnect-interval-minutes=0",
    "test:soak:hardware": "npm run test:soak:scene -- --driver=udmx",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/three": "^0.184.0",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "usb": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
